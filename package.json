{
  "name": "fika",
  "version": "1.0.0",
  "main": "index.js",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "postinstall": "prisma generate --schema=server/prisma/schema.prisma",
    "dev": "concurrently \"npm run dev -w client\" \"npm run dev -w server\"",
    "start:client": "npm run dev -w client",
    "start:server": "npm run dev -w server",
    "build": "npm run generate -w server && npm run build -w client && mkdir -p dist public && cp -r client/dist/* dist/ && cp -r client/dist/* public/",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.18.0",
    "prisma": "^6.2.1"
  }
}