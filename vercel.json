{
    "version": 2,
    "outputDirectory": "client/dist",
    "functions": {
        "api/index.ts": {
            "includeFiles": "server/prisma/schema.prisma"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.ts"
        },
        {
            "source": "/auth/(.*)",
            "destination": "/api/index.ts"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/daily-emails",
            "schedule": "0 8 * * *"
        }
    ]
}