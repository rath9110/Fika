{
    "version": 2,
    "functions": {
        "server/src/index.ts": {
            "runtime": "@vercel/node@3.2.0",
            "includeFiles": "server/prisma/schema.prisma"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/server/src/index.ts"
        },
        {
            "source": "/auth/(.*)",
            "destination": "/server/src/index.ts"
        }
    ]
}