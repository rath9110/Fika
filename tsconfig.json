{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true
    },
    "include": [
        "api/**/*",
        "server/src/**/*"
    ]
}